# Скопируй этот файл в .env и подставь свои значения.
BOT_TOKEN=123456789:PASTE_YOUR_TELEGRAM_BOT_TOKEN
BINGX_API_KEY=PASTE_YOUR_BINGX_API_KEY
BINGX_SECRET_KEY=PASTE_YOUR_BINGX_SECRET_KEY

# Можно несколько ID: через запятую, пробел, ; или перенос строки.
# Только эти пользователи имеют доступ и получают алерты/отчёты.
ALLOWED_TELEGRAM_IDS=123456789,987654321,555666777

# Один из разрешённых ID. Только он видит ручную синхронизацию.
ADMIN_TELEGRAM_ID=123456789

# Для твоего аккаунта v1 уже подтверждён рабочими логами.
COMMISSION_API_VERSION=v1

# Алерт только при депозите USDT СТРОГО больше указанной суммы.
DEPOSIT_ALERT_THRESHOLD_USDT=500

DATABASE_PATH=data/bingx_crm.sqlite3
